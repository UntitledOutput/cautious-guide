#version 450 core
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer Particles  { InkParticle particles[]; };
layout(std430, binding = 1) readonly buffer TileCounts { uint tileCounts[]; };
layout(std430, binding = 2) readonly buffer TileLists  { uint tileLists[]; };

layout(rgba16f, binding = 0) uniform image2D uColor;
layout(binding = 0) uniform sampler2D uSceneDepth;

uniform mat4  uInvViewProj;
uniform vec3  uCameraPos;
uniform vec3  uLightDir;     // direction the light travels
uniform uvec2 uTileCount;
uniform float uBlendK;       // 1.0 in the Unity version
uniform float uMaxDistance;

const int   MAX_STEPS = 32;
const float HIT_EPS   = 0.005;

shared vec4 sPosRadius[MAX_PER_TILE];
shared vec3 sColor[MAX_PER_TILE];
shared uint sCount;

float smin(float a, float b, float k, out float h) {
    h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

float inkDist(vec3 p) {
    float d = 1e9;
    for (uint i = 0u; i < sCount; ++i) {
        vec4  pr   = sPosRadius[i];
        vec3  dv   = p - pr.xyz;
        float cull = pr.w + uBlendK + abs(d);
        if (dot(dv, dv) > cull * cull) continue;

        float h;
        d = smin(d, length(dv) - pr.w, uBlendK, h);
    }
    return d;
}

float inkDistColor(vec3 p, out vec3 color) {
    float d = 1e9;
    color = vec3(0.0);
    for (uint i = 0u; i < sCount; ++i) {
        vec4  pr   = sPosRadius[i];
        vec3  dv   = p - pr.xyz;
        float cull = pr.w + uBlendK + abs(d);
        if (dot(dv, dv) > cull * cull) continue;

        float h;
        d = smin(d, length(dv) - pr.w, uBlendK, h);
        color = mix(sColor[i], color, h);
    }
    return d;
}

// tetrahedral gradient, 4 taps instead of 6
vec3 inkNormal(vec3 p) {
    const vec2 e = vec2(1.0, -1.0) * 0.002;
    return normalize(e.xyy * inkDist(p + e.xyy) +
                     e.yyx * inkDist(p + e.yyx) +
                     e.yxy * inkDist(p + e.yxy) +
                     e.xxx * inkDist(p + e.xxx));
}

vec3 inkLighting(vec3 color, vec3 n, vec3 viewDir, vec3 lightDir) {
    float nDotL   = max(0.0, dot(n, -lightDir));
    float diffuse = nDotL + pow(nDotL, 16.0) + 0.5;
    vec3  outCol  = diffuse * color;

    float sheen = 1.0 - max(0.0, dot(n, viewDir));
    sheen *= sheen;
    return outCol + sheen * 0.5 * diffuse;
}

void main() {
    uint tile = gl_WorkGroupID.y * uTileCount.x + gl_WorkGroupID.x;

    if (gl_LocalInvocationIndex == 0u) sCount = min(tileCounts[tile], MAX_PER_TILE);
    barrier();

    uint count = sCount;
    for (uint i = gl_LocalInvocationIndex; i < count; i += 256u) {
        InkParticle ip = particles[tileLists[tile * MAX_PER_TILE + i]];
        sPosRadius[i] = ip.posRadius;
        sColor[i]     = ip.color.rgb;
    }
    barrier();

    if (count == 0u) return;

    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uColor);
    if (any(greaterThanEqual(px, size))) return;

    vec2 ndc = (vec2(px) + 0.5) / vec2(size) * 2.0 - 1.0;

    // assumes default GL depth range; with glClipControl(GL_ZERO_TO_ONE) pass depth through as-is
    float depth    = texelFetch(uSceneDepth, px, 0).r * 2.0 - 1.0;
    vec4  sceneH   = uInvViewProj * vec4(ndc, depth, 1.0);
    vec4  farH     = uInvViewProj * vec4(ndc, 1.0, 1.0);
    vec3  scenePos = sceneH.xyz / sceneH.w;
    vec3  dir      = normalize(farH.xyz / farH.w - uCameraPos);

    // occlusion: never march past the opaque surface behind this pixel
    float maxT = min(distance(uCameraPos, scenePos), uMaxDistance);

    float t = 0.0;
    bool  hit = false;
    vec3  color;
    for (int s = 0; s < MAX_STEPS; ++s) {
        float d = inkDistColor(uCameraPos + dir * t, color);
        if (d < HIT_EPS) { hit = true; break; }
        t += d;
        if (t > maxT) break;
    }
    if (!hit) return;

    vec3 p = uCameraPos + dir * t;
    vec3 n = inkNormal(p);
    imageStore(uColor, px, vec4(inkLighting(color, n, -dir, uLightDir), 1.0));
}
