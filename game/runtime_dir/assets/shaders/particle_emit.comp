#version 450 core
layout(local_size_x = 64) in;

struct Particle    { vec4 positionLife; vec4 velocitySize; vec4 color; };
struct EmitRequest { vec4 positionStart; vec4 velocitySpread; vec4 color; };

layout(std430) readonly  buffer EmitRequests { EmitRequest requests[]; };
layout(std430) writeonly buffer Instances    { Particle particles[]; };

layout(std140) uniform Params {
    uint requestOffset; uint requestCount; uint spawnCount; uint skip;
    uint head; uint capacity; uint seed; float size; float lifetime;
};

uint hash(uint x) { x ^= x >> 16; x *= 0x7feb352dU; x ^= x >> 15; x *= 0x846ca68bU; x ^= x >> 16; return x; }
float rand(inout uint s) { s = hash(s); return float(s) / 4294967295.0; }

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= spawnCount) return;
    uint n = i + skip;

    uint lo = 0u, hi = requestCount - 1u;
    while (lo < hi) {
        uint mid = (lo + hi + 1u) / 2u;
        if (uint(requests[requestOffset + mid].positionStart.w) <= n) lo = mid; else hi = mid - 1u;
    }
    EmitRequest r = requests[requestOffset + lo];

    uint s = hash(n ^ hash(seed));
    vec3 dir = normalize(vec3(rand(s), rand(s), rand(s)) * 2.0 - 1.0 + 1e-5);
    vec3 vel = r.velocitySpread.xyz + dir * r.velocitySpread.w * rand(s);
    float life = lifetime * mix(0.75, 1.0, rand(s));

    particles[(head + i) % capacity] = Particle(vec4(r.positionStart.xyz, life), vec4(vel, size), r.color);
}
