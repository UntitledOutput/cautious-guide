#version 450 core
// #include "paint_common.glsl"
//
// Replaces the full-texture readback: gameplay pushes the UV2 points it cares about
// (feet, swim checks, splat damage checks) and reads back a few bytes each.
// Dispatch: ceil(queryCount/64) per object, with that object's display paint map bound.

layout(local_size_x = 64) in;

struct PaintQuery {
    vec2 uv;
    uint id;   // whatever the CPU wants back (entity id, contact index...)
    uint pad;
};

struct PaintResult {
    int   team;     // -1 = not inked
    float coverage;
    uint  id;
    uint  pad;
};

layout(std430, binding = 0) readonly  buffer Queries { PaintQuery  queries[]; };
layout(std430, binding = 1) writeonly buffer Results { PaintResult results[]; };

layout(binding = 0) uniform sampler2D uPaint;

uniform uint uQueryOffset;
uniform uint uQueryCount;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uQueryCount) return;

    uint idx = uQueryOffset + i;
    PaintQuery  q = queries[idx];
    PaintSample s = samplePaint(uPaint, q.uv);

    results[idx] = PaintResult(isInked(s) ? s.team : -1, s.coverage, q.id, 0u);
}
