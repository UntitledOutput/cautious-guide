#version 450 core
// #include "paint_common.glsl"
//
// Core paint map -> display paint map. Island texels copy straight through, texels outside
// islands take the nearest island texel so filtering never pulls in unpainted gutter.
// Copies whole texels (not a per-channel max) so team ids never get mixed.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D uPaintCore;
layout(binding = 1) uniform sampler2D uPositionMap;
layout(rg8, binding = 0) writeonly uniform image2D uPaintDisplay;

uniform int uDilateRadius; // texels, 2 is plenty at 1024

void main() {
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uPaintDisplay);
    if (any(greaterThanEqual(px, size))) return;

    if (texelFetch(uPositionMap, px, 0).w >= 0.5) {
        imageStore(uPaintDisplay, px, texelFetch(uPaintCore, px, 0));
        return;
    }

    float best  = 1e9;
    vec4  value = vec4(0.0);
    for (int dy = -uDilateRadius; dy <= uDilateRadius; ++dy) {
        for (int dx = -uDilateRadius; dx <= uDilateRadius; ++dx) {
            ivec2 q = clamp(px + ivec2(dx, dy), ivec2(0), size - 1);
            if (texelFetch(uPositionMap, q, 0).w < 0.5) continue;

            float dist = float(dx * dx + dy * dy);
            if (dist < best) {
                best  = dist;
                value = texelFetch(uPaintCore, q, 0);
            }
        }
    }

    imageStore(uPaintDisplay, px, value);
}
