#version 450 core
layout(local_size_x = 8, local_size_y = 8) in;

struct Splat
{
    vec4 positionSize;
    vec4 normalFalloff;
    vec4 colorStrength;
};

layout(std430) readonly buffer Splats
{
    Splat splats[];
};

layout(std140) uniform Params
{
    uint splatOffset;
    uint splatCount;
    float noiseScale;
};

layout(rg8) uniform image2D paintTex;
layout(rgba32f) readonly uniform image2D positionTex;
layout(rgba16f) readonly uniform image2D normalTex;
layout(rgba8) readonly uniform image2D noiseTex;

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(paintTex);
    if (any(greaterThanEqual(px, size)))
        return;

    vec4 pos = imageLoad(positionTex, px);
    if (pos.w < 0.5)
        return;

    vec3 normal = imageLoad(normalTex, px).xyz;
    vec2 uv = (vec2(px) + 0.5) / vec2(size);
    float noise = imageLoad(noiseTex, ivec2(fract(uv * noiseScale) * vec2(imageSize(noiseTex)))).r;

    vec2 paint = imageLoad(paintTex, px).rg;
    float coverage = paint.r;
    int team = int(paint.g * 3.0 + 0.5);
    bool changed = false;

    for (uint i = splatOffset; i < splatOffset + splatCount; ++i)
    {
        Splat s = splats[i];
        float radius = s.positionSize.w;
        float outer = max(radius * s.normalFalloff.w, radius + 0.0001);
        float d = distance(pos.xyz, s.positionSize.xyz);
        if (d >= outer)
            continue;

        float f = 1.0 - smoothstep(radius, outer, d);
        f *= mix(1.0, noise, s.colorStrength.z);
        f *= smoothstep(-0.6, -0.2, dot(normal, s.normalFalloff.xyz));
        f *= s.colorStrength.y;
        if (f <= 0.0)
            continue;

        int color = int(s.colorStrength.x);
        if (coverage <= 0.0 || team == color)
        {
            team = color;
            coverage = min(1.0, coverage + f);
        }
        else
        {
            coverage -= f;
            if (coverage < 0.0)
            {
                team = color;
                coverage = min(1.0, -coverage);
            }
        }
        changed = true;
    }

    if (changed)
        imageStore(paintTex, px, vec4(coverage, float(team) / 3.0, 0.0, 0.0));
}